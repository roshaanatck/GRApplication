{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "admin-lte@3.2.0",
      "destination": "wwwroot/lib/admin-lte/"
    },
    {
      "provider": "jsdelivr",
      "library": "@fortawesome/fontawesome-free@6.1.1",
      "destination": "wwwroot/lib/fortawesome/fontawesome-free/"
    },
    {
      "library": "overlayscrollbars@2.11.0",
      "destination": "wwwroot/lib/overlayscrollbars/"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/dist/",
      "files": [
        "jquery.min.js"
      ]
    },
    {
      "library": "bootstrap@4.6.2",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "js/bootstrap.min.js",
        "js/bootstrap.bundle.min.js",
        "css/bootstrap.min.css"
      ]
    }
  ]
}